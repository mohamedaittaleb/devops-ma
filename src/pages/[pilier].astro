---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import ListeArticles from '../components/ListeArticles.astro';
import Sponsor from '../components/Sponsor.astro';
import { PILIERS_LISTE } from '../consts';
import { articlesDuPilier } from '../lib/articles';

export const getStaticPaths: GetStaticPaths = async () =>
  PILIERS_LISTE.map((pilier) => ({ params: { pilier: pilier.slug }, props: { pilier } }));

// getStaticPaths ne propage pas le type de ses props jusqu'a Astro.props :
// on le declare, sinon tout arrive en `unknown`.
interface Props { pilier: (typeof PILIERS_LISTE)[number] }
const { pilier } = Astro.props;
const articles = await articlesDuPilier(pilier.slug);

const filAriane = [
  { nom: 'Accueil', chemin: '/' },
  { nom: pilier.nom, chemin: `/${pilier.slug}` },
];
---
<Base titre={pilier.titre} description={pilier.description} filAriane={filAriane}>
  <div data-pilier={pilier.slug}>
    <section class="trame">
      <div class="enveloppe tete">
        <p class="etiquette kicker">
          <span class="pastille" aria-hidden="true"></span>Rubrique
        </p>
        <h1>{pilier.titre}</h1>
        <p class="chapeau">{pilier.description}</p>
        <p class="compte">{articles.length} article{articles.length > 1 ? 's' : ''}</p>
      </div>
    </section>

    <div class="enveloppe"><Sponsor /></div>

    <div class="enveloppe">
    <ListeArticles
      articles={articles}
      montrerPilier={false}
      vide={`Aucun article publié dans « ${pilier.nom} » pour l’instant.`}
      />
    </div>
  </div>
</Base>

<style>
  .tete { padding-block: 3.2rem 0; }
  .kicker { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 .9rem; color: var(--accent); }
  .pastille {
    width: 7px; height: 7px; border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .tete h1 {
    font-size: clamp(1.7rem, 5vw, 2.1rem); font-weight: 640;
    letter-spacing: -.035em; margin: 0 0 .7rem; text-wrap: balance;
  }
  .chapeau {
    margin: 0; color: var(--texte-doux); max-width: 58ch;
    font-family: var(--police-lecture); font-size: 1.04rem; line-height: 1.68;
  }
  .compte {
    margin: 1.1rem 0 0;
    font-family: var(--mono); font-size: 11.5px; letter-spacing: .06em;
    text-transform: uppercase; color: var(--texte-tres-doux);
  }
</style>
