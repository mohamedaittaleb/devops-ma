---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ListeArticles from '../../components/ListeArticles.astro';
import EnteteDePage from '../../components/EnteteDePage.astro';
import { tousLesArticles, tousLesTags, slugTag, TAGS_SEUIL_INDEX, type Article } from '../../lib/articles';

export const getStaticPaths: GetStaticPaths = async () => {
  const articles = await tousLesArticles();
  return (await tousLesTags()).map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tag, articles: articles.filter((a) => a.data.tags.some((t) => slugTag(t) === slug)) },
  }));
};

interface Props { tag: string; articles: Article[] }
const { tag, articles } = Astro.props;

// Une page de tag a un seul article ne fait que repeter son resume : pour un
// moteur, c'est une copie mince de l'article, en concurrence avec lui. Elle
// reste utile a la navigation, mais sort de l'index et du sitemap jusqu'a ce
// qu'un deuxieme article la rejoigne. Meme seuil que src/pages/sitemap-0.xml.ts.
const mince = articles.length < TAGS_SEUIL_INDEX;

const titres = articles.slice(0, 3).map((a) => `« ${a.data.titre} »`).join(', ');
const description = `${articles.length} article${articles.length > 1 ? 's' : ''} en français sur ${tag}, côté DevOps : ${titres}${articles.length > 3 ? '…' : '.'}`;
---
<Base
  titre={`${tag} : articles DevOps en français`}
  description={description.length > 200 ? `${description.slice(0, 197)}…` : description}
  noindex={mince}
>
  <EnteteDePage
    kicker="Tag"
    titre={tag}
    mono={true}
    note={`${articles.length} article${articles.length > 1 ? 's' : ''}`}
  />
  <div class="enveloppe"><ListeArticles articles={articles} /></div>
</Base>

<style>
  /* La mise en page vient de EnteteDePage ; rien de specifique ici. */
</style>
