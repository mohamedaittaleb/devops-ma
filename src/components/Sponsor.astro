---
import { SPONSOR } from '../data/sponsor';
import { SITE } from '../consts';
import { lien } from '../lib/lien';

// Les deux variables portent l'identite du sponsor jusqu'au CSS. Le composant
// n'a ainsi aucune couleur de marque en dur : le prochain sponsor changera
// sponsor.ts, pas cette feuille de style.
const teintes = `--sp-fond: ${SPONSOR.fond}; --sp-couleur: ${SPONSOR.couleur};`;
---
<aside class="sponsor" aria-label="Emplacement sponsor">
  {SPONSOR.actif ? (
    <a href={SPONSOR.url} rel="sponsored noopener" class="carte marque" style={teintes}>
      <p class="bandeau">
        <span class="point" aria-hidden="true"></span>
        <span class="etiquette">Sponsor</span>
      </p>

      <p class="slogan">{SPONSOR.accroche}</p>

      <p class="invite">
        {SPONSOR.logo && (
          <img
            src={lien(SPONSOR.logo)}
            alt={SPONSOR.nom}
            width={SPONSOR.logoLargeur}
            height={SPONSOR.logoHauteur}
            loading="lazy"
            decoding="async"
          />
        )}
        <span class="appel">{SPONSOR.appel} <span aria-hidden="true">&#8599;</span></span>
      </p>
    </a>
  ) : (
    <a href={`mailto:${SITE.email}?subject=Sponsoring%20devops.ma`} class="carte vide">
      <p class="bandeau">
        <span class="point" aria-hidden="true"></span>
        <span class="etiquette">Emplacement libre</span>
      </p>

      <p class="slogan">Un sponsor à la fois, sans script tiers ni cookie.</p>

      <p class="invite">
        <strong>{SITE.title}</strong>
        <span class="appel">Nous écrire <span aria-hidden="true">&#8599;</span></span>
      </p>
    </a>
  )}
</aside>

<style>
  /* Hauteur reservee en permanence, et identique dans les deux etats : meme
     structure a trois lignes, donc activer ou retirer un sponsor ne decale
     jamais ce qui suit. */
  .sponsor { min-height: 132px; display: flex; margin-block: 2.4rem; }

  .carte {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; gap: 9px;
    width: 100%; padding: 14px 16px 15px 19px;
    border-radius: 6px;
    text-decoration: none;
    transition: border-color var(--transition);
  }

  /* Filet vertical : le seul aplat de couleur de marque, et il fait 3 px.
     Tout le reste de la carte est du texte sur un fond uni. */
  .carte::before {
    content: ''; position: absolute; inset: 0 auto 0 0; width: 3px;
  }

  .bandeau { display: flex; align-items: center; gap: 8px; margin: 0; }
  .point { width: 5px; height: 5px; border-radius: 1px; }

  /* Le slogan passe avant la marque : c'est lui qu'on lit. */
  .slogan {
    margin: 0;
    font-family: var(--police-lecture);
    font-size: 1.14rem; line-height: 1.45; font-weight: 500;
    text-wrap: balance;
  }

  .invite {
    display: flex; align-items: center; flex-wrap: wrap; gap: 14px;
    margin: 3px 0 0; font-size: 14px;
  }
  .invite strong { font-weight: 640; }

  /* L'invitation reste un bouton -- sans lui la carte se lit comme une
     citation et personne ne clique -- mais un bouton rectangulaire a bord
     fin, pas une gelule qui brille. */
  .appel {
    margin-left: auto;
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--mono); font-size: 12.5px; font-weight: 500;
    border-radius: 4px; padding: 6px 12px;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }

  /* ---------------------------------------------------------------
     Sponsor actif : la carte prend les couleurs de la marque, fond compris,
     et reste donc sombre dans les deux themes du site. C'est voulu : un
     encart paye doit se lire comme un encart paye.

     Le fond est uni et la couleur de marque n'apparait qu'a trois endroits
     minuscules -- le filet, la puce, le bord du bouton. Un vert a saturation
     maximale sur une grande surface, avec degrade et halo, donne exactement
     l'encart generique qu'on voulait eviter : la retenue fait le travail.
     Toutes les valeurs viennent de --sp-*, aucune n'est en dur.
     --------------------------------------------------------------- */
  .marque {
    background: var(--sp-fond);
    border: 1px solid rgb(255 255 255 / .12);
  }
  .marque::before { background: var(--sp-couleur); }
  .marque:hover { border-color: rgb(255 255 255 / .28); }

  /* L'etiquette reste grise : reserver la couleur aux trois accents lui rend
     sa valeur de signal. */
  .marque .etiquette { color: rgb(255 255 255 / .42); }
  .marque .point { background: var(--sp-couleur); }
  .marque .slogan { color: #fff; }

  .marque img {
    /* Affiche au tiers de sa taille reelle : le fichier fait 480 px de large,
       ce qui couvre les ecrans a forte densite sans requete supplementaire. */
    width: 160px; height: 40px; flex: none;
  }

  .marque .appel {
    color: var(--sp-couleur);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--sp-couleur) 45%, transparent);
  }
  .marque:hover .appel {
    background: var(--sp-couleur);
    border-color: var(--sp-couleur);
    color: var(--sp-fond);
  }

  /* ---------------------------------------------------------------
     Emplacement libre : meme carte, tenue neutre. Pas de couleur de marque,
     puisqu'il n'y a pas de marque a annoncer.
     --------------------------------------------------------------- */
  .vide {
    background: var(--fond-2);
    border: 1px dashed var(--trait-fort);
  }
  .vide::before { background: var(--trait-fort); }
  .vide:hover { border-color: var(--texte-tres-doux); }
  .vide .etiquette { color: var(--texte-tres-doux); }
  .vide .point { background: var(--texte-tres-doux); }
  .vide .slogan { font-size: 1rem; color: var(--texte-doux); font-style: italic; }
  .vide strong { color: var(--texte); }
  .vide .appel {
    color: var(--texte-doux); background: var(--fond);
    border: 1px solid var(--trait-fort);
  }
  .vide:hover .appel { background: var(--fond-3); color: var(--texte); }

  @media (max-width: 520px) {
    .slogan { font-size: 1.06rem; }
    .appel { margin-left: 0; }
    .marque img { width: 136px; height: 34px; }
  }
</style>
