---
import '../styles/global.css';
import Entete from '../components/Entete.astro';
import PiedPage from '../components/PiedPage.astro';
import { SITE } from '../consts';
import { lien, lienAbsolu } from '../lib/lien';

interface Props {
  titre: string;
  description?: string;
  type?: 'website' | 'article';
  canonique?: string;
  publieLe?: Date;
  majLe?: Date;
  motsCles?: readonly string[];
  filAriane?: { nom: string; chemin: string }[];
  noindex?: boolean;
}

const {
  titre,
  description = SITE.description,
  type = 'website',
  canonique = new URL(Astro.url.pathname, Astro.site).href,
  publieLe,
  majLe,
  motsCles,
  filAriane,
  noindex = false,
} = Astro.props;

const titreComplet = titre === SITE.title ? titre : `${titre} — ${SITE.title}`;
const ogImage = lienAbsolu('/og.png', Astro.site);

/**
 * Les trois entites du site portent un @id stable et ne sont decrites qu'une
 * fois ; partout ailleurs on s'y refere par cet identifiant. Sans cela chaque
 * page repete la fiche auteur en entier, et un moteur n'a aucun moyen de
 * savoir que ces copies designent une seule et meme personne.
 */
const ID_SITE = `${SITE.url}/#site`;
const ID_AUTEUR = `${SITE.url}/#auteur`;

// `sameAs` relie la personne a ses profils publics : c'est ce rattachement qui
// fait passer l'auteur du statut de chaine de caracteres a celui d'entite
// identifiable, le seul qui compte pour l'autorite d'un blog technique.
const auteur = {
  '@type': 'Person',
  '@id': ID_AUTEUR,
  name: SITE.auteur,
  url: `${SITE.url}/`,
  sameAs: [SITE.linkedin, SITE.github],
};

const siteWeb = {
  '@type': 'WebSite',
  '@id': ID_SITE,
  name: SITE.title,
  url: `${SITE.url}/`,
  description: SITE.description,
  inLanguage: SITE.langue,
  publisher: { '@id': ID_AUTEUR },
};

const page = type === 'article'
  ? {
      '@type': 'BlogPosting',
      '@id': canonique,
      headline: titre,
      description,
      url: canonique,
      mainEntityOfPage: { '@id': canonique },
      isPartOf: { '@id': ID_SITE },
      image: ogImage,
      inLanguage: SITE.langue,
      author: { '@id': ID_AUTEUR },
      publisher: { '@id': ID_AUTEUR },
      ...(publieLe ? { datePublished: publieLe.toISOString() } : {}),
      // Sans dateModified, une revision reste invisible : l'article continue
      // d'etre date de sa publication. A defaut de `maj`, la date de parution
      // fait foi -- la repeter vaut mieux qu'omettre le champ.
      ...(majLe ?? publieLe ? { dateModified: (majLe ?? publieLe)!.toISOString() } : {}),
      ...(motsCles?.length ? { keywords: motsCles.join(', ') } : {}),
    }
  : {
      '@type': 'WebPage',
      '@id': canonique,
      name: titreComplet,
      description,
      url: canonique,
      isPartOf: { '@id': ID_SITE },
      inLanguage: SITE.langue,
    };

/**
 * Le fil d'Ariane est deja affiche en haut des articles ; le declarer ici le
 * rend exploitable par un moteur, qui l'affiche alors sous le titre du resultat
 * a la place de l'URL brute.
 *
 * La barre finale est ajoutee pour coller a <link rel="canonical"> : sans elle,
 * l'etape designerait une adresse qui redirige vers la page canonique au lieu
 * de la designer directement.
 */
const canoniqueDe = (chemin: string) => {
  const url = lienAbsolu(chemin, Astro.site);
  return url.endsWith('/') ? url : `${url}/`;
};

const fil = filAriane?.length
  ? [{
      '@type': 'BreadcrumbList',
      '@id': `${canonique}#fil`,
      itemListElement: filAriane.map((etape, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: etape.nom,
        item: canoniqueDe(etape.chemin),
      })),
    }]
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [auteur, siteWeb, page, ...fil],
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="fr_MA" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={lien("/favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={lien("/rss.xml")} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fdfdfc" media="(prefers-color-scheme: light)" />

    <!-- Applique le theme memorise avant le premier rendu, pour eviter le flash. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#contenu" class="saut">Aller au contenu</a>
    <Entete />
    <main id="contenu"><slot /></main>
    <PiedPage />

    <!-- Un seul ecouteur delegue pour tous les blocs de code de la page :
         rien a rebrancher quand le contenu change, et aucun cout par bloc. -->
    <script is:inline>
      document.addEventListener('click', async (evenement) => {
        const bouton = evenement.target.closest('[data-copier]');
        if (!bouton) return;
        const pre = bouton.closest('.bloc-code')?.querySelector('pre');
        if (!pre) return;

        const libelle = (texte, etat) => {
          bouton.textContent = texte;
          if (etat) bouton.dataset.etat = etat;
          else delete bouton.dataset.etat;
        };

        try {
          // innerText, pas textContent : il respecte les sauts de ligne rendus.
          await navigator.clipboard.writeText(pre.innerText.trimEnd());
          libelle('copié', 'copie');
        } catch {
          // Presse-papiers refuse (contexte non securise, permission) : le dire
          // plutot que d'afficher un succes qui n'a pas eu lieu.
          libelle('échec');
        }
        setTimeout(() => libelle('copier'), 1600);
      });
    </script>

    <style is:global>
      .saut {
        position: absolute; left: -9999px;
        background: var(--accent); color: #fff; padding: 10px 16px; border-radius: 0 0 6px 0;
      }
      .saut:focus { left: 0; top: 0; z-index: 50; }
    </style>
  </body>
</html>
